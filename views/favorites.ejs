<!DOCTYPE html>
<html lang="hy">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>Պահվածներ — Ijevan</title>

<link
    rel="stylesheet"
    href="/css/style.css"
>

</head>

<body>

<%- include("partials/nav") %>

<main class="container">

<div class="section-title">

<div>

<small>
    ՔՈ ՑԱՆԿԸ
</small>

<h1>
    ❤️ Պահված պրոֆիլներ
</h1>

</div>

</div>


<% if (!profiles.length) { %>

<div class="empty">

<div class="empty-icon">
    ❤️
</div>

<h3>
    Դեռ ոչինչ չես պահել
</h3>

<p>
    Գտիր հետաքրքիր պրոֆիլներ
    և պահիր դրանք այստեղ։
</p>

<a
    href="/"
    class="btn"
>
    Գտնել պրոֆիլներ
</a>

</div>

<% } %>


<div class="profile-grid">

<% profiles.forEach(p => { %>

<article class="profile-card">

<div class="profile-image">

<% if (p.image) { %>

<img src="<%= p.image %>">

<% } else { %>

<span>
    <%= p.icon %>
</span>

<% } %>

</div>

<div class="profile-body">

<div class="profile-category">

<%= p.icon %>
<%= p.category %>

</div>

<h3>
    <%= p.title %>
</h3>

<p>
    <%= p.description %>
</p>

<a
    href="/profile/<%= p.id %>"
    class="btn full"
>
    Դիտել →
</a>

</div>

</article>

<% }) %>

</div>

</main>

</body>

</html>